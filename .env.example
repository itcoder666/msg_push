# PushPlus: configure this token to enable PushPlus.
PUSHPLUS_TOKEN=your_pushplus_token_here
# Optional: PushPlus group code (群组编码) for one-to-many messages.
PUSHPLUS_TOPIC=your_group_code_here

# WeChat Work group robot: configure this webhook URL to enable the channel.
WECHAT_WORK_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=your_key_here

# WxPusher: configure app token and at least one recipient list to enable the channel.
WXPUSHER_APP_TOKEN=your_wxpusher_app_token_here
WXPUSHER_UIDS=UID_xxx,UID_yyy
WXPUSHER_TOPIC_IDS=100,200

# Optional overrides:
# SINA_EXCHANGE_URL=https://hq.sinajs.cn/list=fx_susdcny
# PUSHPLUS_URL=https://www.pushplus.plus/send
# WXPUSHER_URL=https://wxpusher.zjiecode.com/api/send/message
